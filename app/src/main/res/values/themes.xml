<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PDFEditor" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/accent_blue</item>
        <item name="android:windowBackground">@color/bg_canvas</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="android:statusBarColor">@color/bg_canvas</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Strict Flat UI (0dp Corners) -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.PDFEditor.ZeroCorner</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.PDFEditor.ZeroCorner</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.PDFEditor.ZeroCorner</item>

        <!-- Button styles flat -->
        <item name="materialButtonStyle">@style/Widget.PDFEditor.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.PDFEditor.Button.Outlined</item>
        <item name="materialCardViewStyle">@style/Widget.PDFEditor.Card</item>
    </style>

    <style name="ShapeAppearance.PDFEditor.ZeroCorner" parent="ShapeAppearance.Material3.Corner.None">
        <item name="cornerSize">0dp</item>
        <item name="cornerFamily">cut</item>
    </style>

    <style name="Widget.PDFEditor.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">0dp</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="shapeAppearance">@style/ShapeAppearance.PDFEditor.ZeroCorner</item>
    </style>

    <style name="Widget.PDFEditor.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">0dp</item>
        <item name="elevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/color_border</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="shapeAppearance">@style/ShapeAppearance.PDFEditor.ZeroCorner</item>
    </style>

    <style name="Widget.PDFEditor.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">0dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardMaxElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/color_border</item>
        <item name="shapeAppearance">@style/ShapeAppearance.PDFEditor.ZeroCorner</item>
    </style>
</resources>
